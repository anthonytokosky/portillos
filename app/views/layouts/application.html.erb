<!DOCTYPE html>
<html>
<head>
  <title>Portillos</title>
  <%= stylesheet_link_tag 'application', media: 'all' %>
  <%= javascript_include_tag 'application' %>
  <%= csrf_meta_tags %>
</head>
<body>
  <% if flash[:notice] %>
    <div class="notice"><%= flash[:notice] %></div>
  <% end %>
  View on desktop 4 super effects <br>
  <%= link_to "Send a text", new_message_path %> <%= link_to "Responses", messages_path %> <%= link_to "What is this", info_path %>
  <br>

  <%= image_tag "food.jpg", id: "food" %>
  <%= image_tag "logo.jpeg", id: "logo" %>
  <%= image_tag "hotdog.jpeg", id: "hotdog" %>

  <%= yield %>

</body>
</html>
